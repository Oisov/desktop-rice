/* Dropdown menu that hangs under the waybar pills (top-right). */
/* Hover moves the selection; one click runs the row. */
configuration {
  hover-select: true;
  me-select-entry: "MouseSecondary";
  me-accept-entry: "MousePrimary";
}
* {
  font: "JetBrainsMono Nerd Font Propo SemiBold 13";
  background-color: transparent;
  text-color: @fg;
}
/* Colors follow the applied Dynamite theme. */
@import "~/.local/state/dynamite/palette.rasi"
* { bg-alt: @surface; fg: @text; dim: @muted; }
window {
  location: north east;
  anchor: north east;
  x-offset: -10px;
  y-offset: 56px;
  width: 400px;
  background-color: @bg;
  border: 1px;
  border-color: @line;
  border-radius: 20px;
  padding: 14px;
}
mainbox { spacing: 10px; children: [ inputbar, message, listview ]; }
inputbar {
  background-color: @bg-alt;
  border-radius: 14px;
  padding: 9px 14px;
  spacing: 10px;
  children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry { placeholder: "Search"; placeholder-color: @dim; }
message { background-color: @bg-alt; border-radius: 14px; padding: 9px 14px; }
textbox { text-color: @fg; }
listview { lines: 9; fixed-height: false; scrollbar: false; spacing: 3px; }
element { padding: 9px 14px; border-radius: 14px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element normal.active, element alternate.active { text-color: @fg; }
element selected.normal, element selected.active { background-color: @hover; text-color: @fg; }
element-text { text-color: inherit; vertical-align: 0.5; }
