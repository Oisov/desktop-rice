[Unit]
Description=Switch wallpaper at slot boundaries (night 20:00, morning 05:00, day 09:30, evening 16:30)

[Timer]
OnCalendar=*-*-* 05:00:00
OnCalendar=*-*-* 09:30:00
OnCalendar=*-*-* 16:30:00
OnCalendar=*-*-* 20:00:00
# Catch up after suspend; the script itself works out the slot.
OnStartupSec=1min
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
